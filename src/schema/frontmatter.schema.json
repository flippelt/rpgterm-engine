{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flippelt/rpgterm-engine/schema/frontmatter.schema.json",
  "title": "rpgterm-engine locked-file front-matter",
  "description": "Flags parsed from a leading --- block on a VFS file. Values coerce to bool/number unless quoted. Extra keys are allowed.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "locked": { "type": "boolean" },
    "password": { "type": ["string", "number"] },
    "reveals": { "type": "string" },
    "crackable": { "type": "boolean" },
    "crackDC": { "type": "number" },
    "crackAttempts": { "type": "number" },
    "crackTime": { "type": "number" },
    "lockLabel": { "type": "string" },
    "crackFailMessage": { "type": "string" },
    "crackSuccessMessage": { "type": "string" },
    "decryptGame": { "type": "boolean" },
    "decryptTarget": { "type": "string" },
    "decryptWord": { "type": "string" },
    "decryptWords": { "type": "string" },
    "decryptAttempts": { "type": "number" },
    "decryptLabel": { "type": "string" },
    "decryptTime": { "type": "number" },
    "decryptLuck": { "type": "boolean" },
    "tracer": { "type": "boolean" },
    "tracerSeconds": { "type": "number" },
    "tracerPenalty": { "type": "number" },
    "tracerStartAfter": { "type": "number" },
    "tracerNocrackSeconds": { "type": "number" },
    "checkDC": { "type": "number" },
    "checkAlert": { "type": "string" },
    "checkMisleadsOnFail": { "type": "boolean" },
    "image": { "type": "string" },
    "imageAlt": { "type": "string" }
  }
}
